# Icarus container environment file
# Used to ensure whitespace in the SESSIONNAME works

# should be placed in $HOME/.config/containers/systemd/icarus.env
# Then issue as the user:
#    systemctl --user daemon-reload
#    systemctl --user start icarus

RESUME_PROSPECT=false
SESSIONNAME=MY ICARUS SERVER
SHUTDOWNNOTJOINEDFOR=40
SHUTDOWNEMPTYFOR=30
JOINPASSWORD=mysecret
ADMINPASSWORD=mysecret2
GAMESAVEFREQUENCY=5
MAXPLAYERS=4
ALLOWNONADMINSLAUNCH=true
PORT=17777
QUERYPORT=27015