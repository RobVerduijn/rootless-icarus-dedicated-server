# Icarus container unit file
# should be placed in $HOME/.config/containers/systemd/icarus.container
# Then issue as the user:
#    systemctl --user daemon-reload
#    systemctl --user start icarus

[Unit]
Description=Icarus Dedicated Server
After=network-online.target

[Container]
Image=registry.example.coms:9999/library/icarus-dedicated-server:latest
Pull=always
ContainerName=icarus-dedicated-server
PublishPort=17777:17777/udp
PublishPort=27015:27015/udp
# .volume automatically creates the volume if it does not exist
Volume=%h/game:/home/steam/icarus-server:Z
# Optional: Uncomment and configure if opting into a Steam beta branch
# Environment=STEAM_BETA_BRANCH=experimental
EnvironmentFile=icarus.env

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target